generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  SUPERADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DELETED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StaffRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum FeatureStatus {
  ENABLED
  DISABLED
  COMING_SOON
  MAINTENANCE
}

enum OverrideScope {
  USER
  BUSINESS
  BUSINESS_TYPE
  PLAN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CANCELLED
}

enum InvoiceItemType {
  SERVICE
  INVENTORY
  CUSTOM
}

enum RenderFormat {
  PDF
  PNG
}

enum RenderStatus {
  READY
  EXPIRED
  DELETED
  FAILED
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  CONSUMPTION
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  PENDING
  REJECTED
}

enum WalletOwnerType {
  USER
  BUSINESS
}

enum WalletTxType {
  CHARGE
  DEBIT
  CREDIT
  REFUND
  SMS_COST
  INVOICE_PAYMENT
  PAYOUT
  ADJUSTMENT
}

enum WalletTxStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CoinGrantStatus {
  CLAIMABLE
  CLAIMED
  EXPIRED
  AUTO_CLAIMED
}

enum SmsApprovalMode {
  AUTO
  REVIEW
  DISABLED
}

enum SmsMessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SmsKind {
  OTP
  INVOICE
  INVITE
  TRANSACTIONAL
  CAMPAIGN
}

enum IntegrationCategory {
  OTP
  SMS
  PAYMENT
  MAP
  STORAGE
  TAX
  OTHER
}

enum PaymentStatus {
  CREATED
  REDIRECTED
  VERIFYING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  WALLET_CHARGE
  INVOICE
  PAYMENT_PLAN
  OTHER
}

enum BusinessPaymentMethodType {
  CARD
  IBAN
  ZARINPAL
  WALLET
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportTargetType {
  USER
  BUSINESS
  REVIEW
  INVOICE
  SMS
  OTHER
}

enum ConversationKind {
  CUSTOMER_BUSINESS
  SUPPORT
  INVOICE_REGENERATION
}

enum MessageType {
  TEXT
  SYSTEM
  ATTACHMENT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                   String                @id @default(cuid())
  phone                String                @unique
  accountType          AccountType           @default(CUSTOMER)
  status               AccountStatus         @default(ACTIVE)
  phoneVerifiedAt      DateTime?
  frozenAt             DateTime?
  freezeReason         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  profile              UserProfile?
  ownedBusinesses      Business[]            @relation("BusinessOwner")
  memberships          BusinessMembership[]
  customerInvoices     Invoice[]             @relation("InvoiceCustomer")
  reviews              Review[]
  wallet               Wallet?               @relation("UserWallet")
  coinWallet           CoinWallet?           @relation("UserCoinWallet")
  verificationRequests VerificationRequest[]
  staffRequests        StaffAccountRequest[] @relation("StaffRequester")
  otpChallenges        OtpChallenge[]
  notifications        Notification[]
  reports              Report[]              @relation("ReportReporter")
  messages             Message[]
  auditLogs            AuditLog[]            @relation("AuditActor")
  conversationMembers  ConversationMember[]
}

model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  firstName   String?
  lastName    String?
  username    String?   @unique
  birthDate   DateTime?
  avatarUrl   String?
  bio         String?
  city        String?
  province    String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessType {
  id         String     @id @default(cuid())
  key        String     @unique
  nameFa     String
  nameEn     String?
  iconKey    String
  enabled    Boolean    @default(true)
  schema     Json?
  createdAt  DateTime   @default(now())
  businesses Business[]
}

model Business {
  id                   String                  @id @default(cuid())
  ownerId              String
  businessTypeId       String
  slug                 String                  @unique
  name                 String
  legalName            String?
  username             String?                 @unique
  bio                  String?
  phone                String?
  alternatePhone       String?
  nationalId           String?
  economicCode         String?
  taxMemoryId          String?
  address              String?
  city                 String?
  province             String?
  postalCode           String?
  latitude             Float?
  longitude            Float?
  serviceAreaRadiusKm  Int                     @default(20)
  isAvailable          Boolean                 @default(true)
  isPublic             Boolean                 @default(true)
  isVerified           Boolean                 @default(false)
  verifiedAt           DateTime?
  frozenAt             DateTime?
  freezeReason         String?
  logoUrl              String?
  coverUrl             String?
  signatureUrl         String?
  stampUrl             String?
  bankCardMasked       String?
  ibanMasked           String?
  paymentInstructions  String?
  settings             Json?
  averageRating        Float                   @default(0)
  reviewsCount         Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  owner                User                    @relation("BusinessOwner", fields: [ownerId], references: [id])
  businessType         BusinessType            @relation(fields: [businessTypeId], references: [id])
  memberships          BusinessMembership[]
  staffRequests        StaffAccountRequest[]
  serviceCategories    ServiceCategory[]
  services             Service[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  invoices             Invoice[]
  reviews              Review[]
  wallet               Wallet?                 @relation("BusinessWallet")
  coinWallet           CoinWallet?             @relation("BusinessCoinWallet")
  smsSetting           BusinessSmsSetting?
  smsMessages          SmsMessage[]
  subscriptions        BusinessSubscription[]
  usageCounters        UsageCounter[]
  verificationRequests VerificationRequest[]
  paymentAttempts      PaymentAttempt[]
  paymentMethods       BusinessPaymentMethod[]
  reports              Report[]                @relation("ReportBusiness")
  conversations        Conversation[]
  notifications        Notification[]

  @@index([businessTypeId, isPublic, isAvailable])
  @@index([province, city])
  @@index([latitude, longitude])
}

model BusinessMembership {
  id          String           @id @default(cuid())
  businessId  String
  userId      String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  title       String?
  permissions Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, status])
}

model StaffAccountRequest {
  id           String             @id @default(cuid())
  businessId   String
  requesterId  String
  phone        String
  name         String
  age          Int?
  imageUrl     String?
  role         MembershipRole     @default(STAFF)
  title        String?
  notes        String?
  status       StaffRequestStatus @default(PENDING)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requester    User               @relation("StaffRequester", fields: [requesterId], references: [id])

  @@index([businessId, status])
}

model ServiceCategory {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([businessId, name])
}

model Service {
  id                  String           @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String
  description         String?
  priceRial           BigInt
  unitLabel           String           @default("خدمت")
  taxRateBasisPoints  Int              @default(0)
  taxProductServiceId String?
  durationMinutes     Int?
  active              Boolean          @default(true)
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoiceItems        InvoiceItem[]

  @@index([businessId, active])
}

model InventoryCategory {
  id          String          @id @default(cuid())
  businessId  String
  name        String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       InventoryItem[]

  @@unique([businessId, name])
}

model InventoryItem {
  id                  String              @id @default(cuid())
  businessId          String
  categoryId          String?
  sku                 String?
  barcode             String?
  name                String
  description         String?
  unit                String              @default("عدد")
  currentQty          Decimal             @default(0) @db.Decimal(18, 3)
  minQty              Decimal?            @db.Decimal(18, 3)
  reorderQty          Decimal?            @db.Decimal(18, 3)
  averageCostRial     BigInt              @default(0)
  salePriceRial       BigInt?
  taxRateBasisPoints  Int                 @default(0)
  taxProductServiceId String?
  supplierName        String?
  locationLabel       String?
  trackSerial         Boolean             @default(false)
  trackBatch          Boolean             @default(false)
  active              Boolean             @default(true)
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            InventoryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements           InventoryMovement[]
  invoiceItems        InvoiceItem[]

  @@unique([businessId, sku])
  @@index([businessId, active])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  businessId      String
  inventoryItemId String
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(18, 3)
  unitCostRial    BigInt?
  referenceType   String?
  referenceId     String?
  reason          String?
  batchNo         String?
  serialNo        String?
  occurredAt      DateTime              @default(now())
  createdById     String?
  metadata        Json?
  createdAt       DateTime              @default(now())
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, occurredAt])
  @@index([businessId, occurredAt])
}

model Invoice {
  id               String           @id @default(cuid())
  businessId       String
  customerId       String
  invoiceNo        String
  status           InvoiceStatus    @default(DRAFT)
  currency         String           @default("IRR")
  issuedAt         DateTime?
  dueAt            DateTime?
  subtotalRial     BigInt           @default(0)
  discountRial     BigInt           @default(0)
  taxRial          BigInt           @default(0)
  shippingRial     BigInt           @default(0)
  totalRial        BigInt           @default(0)
  paidRial         BigInt           @default(0)
  notes            String?
  sellerSnapshot   Json
  customerSnapshot Json
  paymentSnapshot  Json?
  taxMetadata      Json?
  renderExpiresAt  DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  business         Business         @relation(fields: [businessId], references: [id])
  customer         User             @relation("InvoiceCustomer", fields: [customerId], references: [id])
  items            InvoiceItem[]
  renders          InvoiceRender[]
  paymentAttempts  PaymentAttempt[]

  @@unique([businessId, invoiceNo])
  @@index([customerId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

model InvoiceItem {
  id                  String          @id @default(cuid())
  invoiceId           String
  type                InvoiceItemType
  serviceId           String?
  inventoryItemId     String?
  title               String
  description         String?
  quantity            Decimal         @db.Decimal(18, 3)
  unitLabel           String
  unitPriceRial       BigInt
  discountRial        BigInt          @default(0)
  taxRateBasisPoints  Int             @default(0)
  taxRial             BigInt          @default(0)
  lineTotalRial       BigInt
  taxProductServiceId String?
  snapshot            Json?
  sortOrder           Int             @default(0)
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service             Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  inventoryItem       InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sortOrder])
}

model InvoiceRender {
  id         String       @id @default(cuid())
  invoiceId  String
  format     RenderFormat
  status     RenderStatus @default(READY)
  storageKey String
  mimeType   String
  sizeBytes  Int
  expiresAt  DateTime
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  invoice    Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([expiresAt, status])
}

model Review {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  rating     Int
  title      String?
  body       String?
  status     ReviewStatus @default(PUBLISHED)
  ownerReply String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId, status, createdAt])
}

model Wallet {
  id           String              @id @default(cuid())
  ownerType    WalletOwnerType
  userId       String?             @unique
  businessId   String?             @unique
  balanceRial  BigInt              @default(0)
  lockedRial   BigInt              @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User?               @relation("UserWallet", fields: [userId], references: [id], onDelete: Cascade)
  business     Business?           @relation("BusinessWallet", fields: [businessId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id               String         @id @default(cuid())
  walletId         String
  type             WalletTxType
  status           WalletTxStatus @default(PENDING)
  amountRial       BigInt
  balanceAfterRial BigInt?
  referenceType    String?
  referenceId      String?
  description      String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  wallet           Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model CoinWallet {
  id             String      @id @default(cuid())
  userId         String?     @unique
  businessId     String?     @unique
  balance        Int         @default(0)
  lifetimeEarned Int         @default(0)
  levelKey       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation("UserCoinWallet", fields: [userId], references: [id], onDelete: Cascade)
  business       Business?   @relation("BusinessCoinWallet", fields: [businessId], references: [id], onDelete: Cascade)
  grants         CoinGrant[]
}

model CoinGrant {
  id           String          @id @default(cuid())
  coinWalletId String
  amount       Int
  status       CoinGrantStatus @default(CLAIMABLE)
  sourceType   String
  sourceId     String?
  sourceKey    String?         @unique
  availableAt  DateTime        @default(now())
  expiresAt    DateTime?
  claimedAt    DateTime?
  metadata     Json?
  createdAt    DateTime        @default(now())
  coinWallet   CoinWallet      @relation(fields: [coinWalletId], references: [id], onDelete: Cascade)

  @@index([coinWalletId, status, availableAt])
}

model LoyaltyLevel {
  id                  String  @id @default(cuid())
  key                 String  @unique
  nameFa              String
  minLifetimeCoins    Int
  autoClaimEnabled    Boolean @default(false)
  discountBasisPoints Int     @default(0)
  benefits            Json?
  active              Boolean @default(true)
  sortOrder           Int     @default(0)
}

model CoinRule {
  id            String   @id @default(cuid())
  key           String   @unique
  nameFa        String
  sourceType    String
  amountPerRial Decimal? @db.Decimal(18, 8)
  fixedCoins    Int?
  minAmountRial BigInt?
  maxCoins      Int?
  claimRequired Boolean  @default(true)
  active        Boolean  @default(true)
  metadata      Json?
}

model Feature {
  id          String            @id @default(cuid())
  key         String            @unique
  nameFa      String
  description String?
  status      FeatureStatus     @default(ENABLED)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  overrides   FeatureOverride[]
  planLimits  PlanLimit[]
}

model FeatureOverride {
  id        String        @id @default(cuid())
  featureId String
  scope     OverrideScope
  scopeId   String
  status    FeatureStatus
  limits    Json?
  reason    String?
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  feature   Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, scope, scopeId])
  @@index([scope, scopeId])
}

model Plan {
  id            String                 @id @default(cuid())
  key           String                 @unique
  nameFa        String
  description   String?
  priceRial     BigInt                 @default(0)
  billingDays   Int                    @default(30)
  active        Boolean                @default(true)
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  limits        PlanLimit[]
  subscriptions BusinessSubscription[]
}

model PlanLimit {
  id         String  @id @default(cuid())
  planId     String
  featureId  String
  limitKey   String
  limitValue BigInt?
  enabled    Boolean @default(true)
  metadata   Json?
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId, limitKey])
}

model BusinessSubscription {
  id         String    @id @default(cuid())
  businessId String
  planId     String
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  active     Boolean   @default(true)
  metadata   Json?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan       Plan      @relation(fields: [planId], references: [id])

  @@index([businessId, active])
}

model UsageCounter {
  id         String   @id @default(cuid())
  businessId String
  key        String
  periodKey  String
  value      BigInt   @default(0)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key, periodKey])
}

model IntegrationConfig {
  id              String              @id @default(cuid())
  category        IntegrationCategory
  providerKey     String
  displayName     String
  enabled         Boolean             @default(false)
  isDefault       Boolean             @default(false)
  encryptedConfig String
  publicConfig    Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([category, providerKey])
  @@index([category, enabled])
}

model BusinessSmsSetting {
  id                   String          @id @default(cuid())
  businessId           String          @unique
  enabled              Boolean         @default(false) // platform/admin permission
  ownerEnabled         Boolean         @default(false) // owner master toggle
  invoiceSmsEnabled    Boolean         @default(false)
  inviteSmsEnabled     Boolean         @default(false)
  campaignSmsEnabled   Boolean         @default(false)
  approvalMode         SmsApprovalMode @default(REVIEW)
  providerKey          String?
  maxDailyMessages     Int?            @default(100)
  ownerTemplateEditing Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SmsTemplate {
  id            String   @id @default(cuid())
  key           String   @unique
  nameFa        String
  kind          SmsKind
  body          String
  variables     Json?
  active        Boolean  @default(true)
  ownerEditable Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SmsMessage {
  id                String           @id @default(cuid())
  businessId        String?
  userId            String?
  phone             String
  kind              SmsKind
  templateKey       String?
  body              String
  status            SmsMessageStatus @default(DRAFT)
  providerKey       String?
  providerMessageId String?
  segments          Int              @default(1)
  unitCostRial      BigInt           @default(0)
  totalCostRial     BigInt           @default(0)
  requestedById     String?
  approvedById      String?
  approvedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failureReason     String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([phone, createdAt])
}

model PaymentAttempt {
  id              String         @id @default(cuid())
  providerKey     String
  purpose         PaymentPurpose
  userId          String?
  businessId      String?
  invoiceId       String?
  amountRial      BigInt
  status          PaymentStatus  @default(CREATED)
  authority       String?        @unique
  referenceId     String?
  callbackToken   String         @unique
  providerPayload Json?
  failureReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  verifiedAt      DateTime?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([businessId, createdAt])
}

model VerificationRequest {
  id                   String             @id @default(cuid())
  userId               String
  businessId           String?
  status               VerificationStatus @default(PENDING)
  legalName            String?
  nationalId           String?
  nationalCardFrontUrl String?
  nationalCardBackUrl  String?
  licenseUrl           String?
  selfieUrl            String?
  notes                String?
  reviewerNote         String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id])
  business             Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  businessId  String?
  targetType  ReportTargetType
  targetId    String?
  category    String
  description String
  status      ReportStatus     @default(OPEN)
  adminNote   String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id])
  business    Business?        @relation("ReportBusiness", fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Conversation {
  id         String               @id @default(cuid())
  kind       ConversationKind
  businessId String?
  subject    String?
  metadata   Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  members    ConversationMember[]
  messages   Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  body           String?
  attachmentUrl  String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  userId      String?
  phone       String
  purpose     String
  providerKey String
  providerRef String?
  codeHash    String?
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  businessId String?
  type       String
  title      String
  body       String
  route      String?
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([businessId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model BusinessPaymentMethod {
  id              String                    @id @default(cuid())
  businessId      String
  type            BusinessPaymentMethodType
  label           String
  enabled         Boolean                   @default(true)
  isDefault       Boolean                   @default(false)
  publicDetails   Json?
  encryptedConfig String?
  sortOrder       Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  business        Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, enabled, sortOrder])
}

model MediaFile {
  id          String          @id @default(cuid())
  ownerUserId String?
  businessId  String?
  purpose     String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  visibility  MediaVisibility @default(PRIVATE)
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([ownerUserId, createdAt])
  @@index([businessId, purpose, createdAt])
}
